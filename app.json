{
  "expo": {
    "name": "CamotesDrive",
    "slug": "CamotesDrive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "camotesdrive",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F8F4",
        "foregroundImage": "./assets/branding/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8F4",
          "image": "./assets/branding/splash-icon.png",
          "imageWidth": 240
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
